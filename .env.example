DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-long-random-secret
# اختياري: يسمح بمعاينة شاشة الدفع التجريبية خارج بيئة التطوير فقط.
# لا تفعّله في الإنتاج عند ربط بوابة الدفع الحقيقية.
VITE_DEMO_PAYMENT=false

# Email (Resend): confirmation / password-reset codes, and admin copies
RESEND_API_KEY=
EMAIL_FROM=عنوان <no-reply@onwan.link>
# Mailbox that receives page reports and beneficiary requests
ADMIN_EMAIL=
# Contact shown to a banned account (optional)
SUPPORT_EMAIL=

# Pages are served on name.<ROOT_DOMAIN>
ROOT_DOMAIN=onwan.link
VITE_ROOT_DOMAIN=onwan.link
# Fixed WhatsApp number of the administration, digits with country code (optional)
VITE_SUPPORT_WHATSAPP=

# Set to true only while testing the signup UI. This skips the landing-page
# availability request to the database; the server still protects unique names
# when the account is actually created.
VITE_SKIP_SIGNUP_USERNAME_CHECK=false

# Admin panel (/admin): one-time secret (16+ chars) for creating the first
# manager account from the «إعداد أول مرة» form. Remove it afterwards.
ADMIN_SETUP_TOKEN=

# «صمّم لي» package price in SAR. Fixed here by design (not editable from the
# admin panel); leave empty until the price is decided.
DESIGN_SERVICE_PRICE_SAR=

# Custom domains (DOMAIN-03). With these set, an activated domain is attached
# to the Vercel project automatically; without them staff add it by hand in
# the Vercel dashboard. VERCEL_TEAM_ID only for a team account.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Background video uploads use the Cloudflare R2 binding MEDIA (wrangler.jsonc);
# no key is needed. They work under `npm run dev:worker`, not plain `npm run dev`.

# Cloudflare Workers uses .dev.vars locally and Worker secrets in production.
# See CLOUDFLARE_DEPLOY.md; the VERCEL_* entries above are legacy only.
CUSTOM_DOMAIN_CNAME_TARGET=onwan.link
CUSTOM_DOMAIN_APEX_IP=
