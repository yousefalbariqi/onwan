{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "nonprofit.onwan.link"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<name>(?!www\\.)[a-z0-9-]+)\\.onwan\\.link"
        }
      ],
      "destination": "/api/public-page?render=html&username=:name"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|src/|@vite/|@react-refresh|@fs/|node_modules/|assets/|favicon\\.ico|vite\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
