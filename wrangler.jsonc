{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onwan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ROOT_DOMAIN": "onwan.link"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "onwan.link",
      "custom_domain": true
    },
    {
      "pattern": "*.onwan.link/*",
      "zone_name": "onwan.link"
    }
  ],
  // Background videos (note 30). Create once: npx wrangler r2 bucket create onwan-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "onwan-media"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7b20b70925bf477da8d97a47cc387570"
    }
  ]
}
