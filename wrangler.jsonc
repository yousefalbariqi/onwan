{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onwan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ROOT_DOMAIN": "onwan.link",
    // REQ-023 Cloudflare Stream (public values; STREAM_API_TOKEN is a secret).
    "CF_ACCOUNT_ID": "0deb932b2d2480c378d564be44a39990",
    "STREAM_CUSTOMER_HOST": "customer-izh2gxj70gpyopwe.cloudflarestream.com",
    // Temporary full-flow test activation, explicitly enabled by the owner.
    "DEMO_PAYMENT_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "onwan.link",
      "custom_domain": true
    },
    {
      "pattern": "*.onwan.link/*",
      "zone_name": "onwan.link"
    }
  ],
  // Background videos (note 30). Create once: npx wrangler r2 bucket create onwan-media
  // Hourly: unused stored files are deleted (30 days if ever saved, else 24 hours — owner, 25 Oct 2026).
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "onwan-media"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7b20b70925bf477da8d97a47cc387570"
    }
  ]
}
